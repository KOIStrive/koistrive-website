<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #050505;
    color: #ffffff;
    font-family: "Inter", Arial, sans-serif;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

:root {
    --red: #e00000;
    --black: #050505;
    --white: #ffffff;
    --gray: #999999;
}

/* NAVIGATION */

nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 82px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 6%;

    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(15px);

    border-bottom: 1px solid rgba(255,255,255,0.08);

    z-index: 1000;
}

.logo {
    font-family: "Anton", sans-serif;
    font-size: 32px;
    letter-spacing: 2px;
    color: white;
}

.logo span {
    color: var(--red);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
}

.nav-links a {
    color: #aaa;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    transition: 0.25s ease;
}

.nav-links a:hover {
    color: var(--red);
}

.youtube {
    border: 1px solid var(--red);
    padding: 12px 18px;
    color: white !important;
}

.youtube:hover {
    background: var(--red);
}

/* HERO */

.hero {
    min-height: 100vh;

    position: relative;

    display: flex;
    align-items: center;

    overflow: hidden;

    padding: 130px 6% 80px;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,0.97) 0%,
            rgba(0,0,0,0.78) 45%,
            rgba(0,0,0,0.45) 100%
        ),
        url("49F565D2-846B-4EBD-82F3-778C2D2DA016.png");

    background-size: cover;
    background-position: center;
}

.hero::after {
    content: "";

    position: absolute;
    inset: 0;

    background:
        radial-gradient(
            circle at 75% 50%,
            rgba(224,0,0,0.25),
            transparent 45%
        );

    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 28px;

    margin-bottom: 30px;

    color: var(--red);

    font-size: 13px;
    font-weight: 900;
    letter-spacing: 6px;
}

.eyebrow::before {
    content: "";
    width: 55px;
    height: 3px;
    background: var(--red);
}

.hero h1 {
    font-family: "Anton", sans-serif;

    font-size: clamp(80px, 14vw, 190px);

    line-height: 0.82;

    letter-spacing: -2px;

    text-transform: uppercase;

    margin-bottom: 45px;
}

.hero h1 span {
    color: var(--red);
}

.hero p {
    max-width: 600px;

    color: #b5b5b5;

    font-size: 18px;

    line-height: 1.8;

    margin-bottom: 40px;
}

.hero-buttons {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 62px;

    padding: 0 35px;

    border: 1px solid #444;

    font-size: 13px;

    font-weight: 900;

    letter-spacing: 2px;

    transition: 0.25s ease;
}

.btn-primary {
    background: var(--red);
    border-color: var(--red);
    color: white;
}

.btn-primary:hover {
    background: #ff1717;
}

.btn-secondary:hover {
    border-color: var(--red);
    color: var(--red);
}

.scroll-text {
    position: absolute;

    bottom: 35px;
    left: 6%;

    color: #666;

    font-size: 11px;

    letter-spacing: 5px;

    font-weight: 700;
}

/* GENERAL SECTIONS */

section {
    position: relative;
    padding: 120px 6%;
}

.section-label {
    color: var(--red);

    font-size: 12px;

    font-weight: 900;

    letter-spacing: 6px;

    margin-bottom: 20px;
}

.section-title {
    font-family: "Anton", sans-serif;

    font-size: clamp(60px, 10vw, 130px);

    line-height: 0.85;

    text-transform: uppercase;

    margin-bottom: 35px;
}

.section-title span {
    color: var(--red);
}

/* KOI ARTWORK */

.artwork-section {
    background:
        radial-gradient(
            circle at center,
            rgba(224,0,0,0.12),
            transparent 55%
        );
}

.artwork {
    width: 100%;

    max-width: 1000px;

    display: block;

    margin: 0 auto 70px;

    border: 1px solid rgba(255,255,255,0.15);

    box-shadow:
        0 0 80px rgba(224,0,0,0.12);
}

.artwork-text {
    max-width: 800px;

    margin: 0 auto;

    text-align: center;
}

.artwork-text p {
    color: #999;

    font-size: 18px;

    line-height: 1.9;
}

/* SYMBOL */

.symbol-section {
    background: #070707;
}

.symbol-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 70px;

    align-items: center;
}

.symbol-image {
    width: 100%;

    display: block;

    border: 1px solid rgba(255,255,255,0.12);
}

.symbol-content h2 {
    font-family: "Anton", sans-serif;

    font-size: clamp(60px, 9vw, 110px);

    line-height: 0.85;

    text-transform: uppercase;

    margin-bottom: 35px;
}

.symbol-content h2 span {
    color: var(--red);
}

.symbol-content p {
    color: #999;

    font-size: 17px;

    line-height: 1.9;
}

/* ABOUT */

.about {
    background:
        linear-gradient(
            180deg,
            #050505,
            #0b0000
        );
}

.about-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.about-card {
    padding: 40px;

    min-height: 230px;

    border: 1px solid rgba(255,255,255,0.1);

    background: rgba(255,255,255,0.025);

    transition: 0.3s ease;
}

.about-card:hover {
    border-color: var(--red);

    transform: translateY(-5px);
}

.about-card h3 {
    font-family: "Anton", sans-serif;

    font-size: 38px;

    margin-bottom: 20px;
}

.about-card p {
    color: #888;

    line-height: 1.8;

    font-size: 15px;
}

/* LATEST */

.latest {
    background: #050505;
}

.latest-box {
    border: 1px solid rgba(255,255,255,0.1);

    padding: 60px;

    background:
        radial-gradient(
            circle at right,
            rgba(224,0,0,0.13),
            transparent 45%
        );
}

.latest-box h3 {
    font-family: "Anton", sans-serif;

    font-size: clamp(55px, 8vw, 100px);

    line-height: 0.9;

    margin-bottom: 25px;
}

.latest-box h3 span {
    color: var(--red);
}

.latest-box p {
    color: #999;

    max-width: 650px;

    line-height: 1.8;

    margin-bottom: 35px;
}

/* CTA */

.cta {
    min-height: 65vh;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    background:
        linear-gradient(
            rgba(0,0,0,0.72),
            rgba(0,0,0,0.9)
        ),
        url("49F565D2-846B-4EBD-82F3-778C2D2DA016.png");

    background-size: cover;

    background-position: center;
}

.cta h2 {
    font-family: "Anton", sans-serif;

    font-size: clamp(70px, 12vw, 150px);

    line-height: 0.85;

    margin-bottom: 30px;
}

.cta h2 span {
    color: var(--red);
}

.cta p {
    color: #aaa;

    max-width: 600px;

    margin: 0 auto 35px;

    line-height: 1.8;
}

/* FOOTER */

footer {
    padding: 60px 6%;

    border-top: 1px solid rgba(255,255,255,0.08);

    background: #000;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    flex-wrap: wrap;
}

.footer-logo {
    font-family: "Anton", sans-serif;

    font-size: 28px;

    letter-spacing: 2px;
}

.footer-logo span {
    color: var(--red);
}

footer p {
    color: #666;

    font-size: 12px;

    letter-spacing: 2px;
}

/* MOBILE */

@media (max-width: 800px) {

    nav {
        height: 72px;
        padding: 0 6%;
    }

    .logo {
        font-size: 27px;
    }

    .nav-links a:not(.youtube) {
        display: none;
    }

    .youtube {
        padding: 10px 13px;
        font-size: 10px;
    }

    .hero {
        min-height: 100vh;

        padding-top: 120px;

        background-position: 65% center;
    }

    .hero h1 {
        font-size: clamp(75px, 21vw, 135px);
    }

    .hero p {
        font-size: 16px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .btn {
        width: 100%;
    }

    section {
        padding: 85px 6%;
    }

    .symbol-grid {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .about-grid {
        grid-template-columns: 1fr;
    }

    .latest-box {
        padding: 35px 25px;
    }

    .scroll-text {
        left: 6%;
        font-size: 9px;
        letter-spacing: 3px;
    }

    footer {
        text-align: center;
        justify-content: center;
    }
}

</style>

</head>


